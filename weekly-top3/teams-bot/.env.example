# Azure Bot registration (Bot Framework)
BOT_APP_ID=
BOT_APP_PASSWORD=

# Azure AD app registration used for Graph API (application permission Mail.Send, admin consented)
AAD_APP_TENANT_ID=
AAD_APP_CLIENT_ID=
AAD_APP_CLIENT_SECRET=

# Mailbox the digest is sent from (must be a real mailbox the app is allowed to send as)
MAIL_SENDER_UPN=weeklytop3@yourcompany.com
CIO_EMAIL=cio@yourcompany.com

# Optional cron overrides (default: Monday 9am reminder, Friday 8am digest)
REMINDER_CRON=0 9 * * 1
DIGEST_CRON=0 8 * * 5

PORT=3978
